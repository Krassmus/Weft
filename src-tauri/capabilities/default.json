{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    "deep-link:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title",
    "clipboard-manager:allow-read-image",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPCACHE/**" }, { "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$HOME/**" }, { "path": "$APPCACHE/**" }, { "path": "$DOCUMENT/**" }, { "path": "$TEMP/**" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "ffmpeg-path", "cmd": "ffmpeg", "args": true },
        { "name": "ffmpeg-homebrew-arm", "cmd": "/opt/homebrew/bin/ffmpeg", "args": true },
        { "name": "ffmpeg-homebrew-intel", "cmd": "/usr/local/bin/ffmpeg", "args": true }
      ]
    }
  ]
}