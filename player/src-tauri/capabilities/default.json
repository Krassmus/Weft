{
  "identifier": "default",
  "description": "Capability for the main window of Weft Player",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "deep-link:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
