# Copy to .env (cp .env.example .env) and fill in. Never commit .env.

# --- the service ---
# Signs the tokens: openssl rand -hex 32
WEFT_CLOUD_TOKEN_SECRET=
# How long a token works (seconds); the app asks again with the proof of its store.
WEFT_CLOUD_TOKEN_TTL=3600
# Requests for a session per address and minute.
SESSIONS_PER_MINUTE=20

# --- TURN (coturn) ---
# The shared secret of the service and coturn: openssl rand -hex 32
TURN_SECRET=
# What the apps are told to use (comma separated). The address has to point to this server.
TURN_URLS=turn:turn.townwork.eu:3478?transport=udp,turn:turn.townwork.eu:3478?transport=tcp
# How long the credentials work (seconds): a call must not be longer than this.
TURN_TTL=86400
TURN_REALM=turn.townwork.eu

# --- the front door (Caddy) ---
CLOUD_HOST=cloud.townwork.eu

# --- development only, NEVER on the server: ---
# WEFT_CLOUD_DEV=1   (accepts the store "dev"; only starts with HOST=127.0.0.1, see `npm run server:dev`)
